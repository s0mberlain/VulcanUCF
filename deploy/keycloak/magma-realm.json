{
  "realm": "magma",
  "enabled": true,
  "displayName": "Vulcan UCF test realm",
  "sslRequired": "none",
  "groups": [{ "name": "SOC-Admins" }, { "name": "SOC-Analysts" }, { "name": "Audit" }],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "alice-password", "temporary": false }],
      "groups": ["/SOC-Admins"]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.test",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Analyst",
      "credentials": [{ "type": "password", "value": "bob-password", "temporary": false }],
      "groups": ["/SOC-Analysts"]
    },
    {
      "username": "carol",
      "enabled": true,
      "email": "carol@example.test",
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "Auditor",
      "credentials": [{ "type": "password", "value": "carol-password", "temporary": false }],
      "groups": ["/Audit"]
    },
    {
      "username": "dave",
      "enabled": true,
      "email": "dave@example.test",
      "emailVerified": true,
      "firstName": "Dave",
      "lastName": "Nogroup",
      "credentials": [{ "type": "password", "value": "dave-password", "temporary": false }]
    }
  ],
  "clients": [
    {
      "clientId": "magma",
      "name": "Vulcan UCF",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "magma-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:8080/api/auth/oidc/callback"],
      "webOrigins": ["http://localhost:8080"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "+" },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
