# Copy to .env and adjust. Variables marked (later) are read from the milestone named.

# Host port for docker compose
MAGMA_PORT=8080

# Public URL of the app (used for SSO redirects)
BASE_URL=http://localhost:8080

# Database: SQLite file in the /data volume (default) or PostgreSQL
DATABASE_URL=sqlite:////data/magma.db
# DATABASE_URL=postgresql+psycopg://magma:secret@postgres:5432/magma
# With the bundled Postgres (docker-compose.postgres.yml) only the password is needed:
# POSTGRES_PASSWORD=
# PostgreSQL pool and limits (defaults shown); statement timeout 0 = off
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=1800
# DB_STATEMENT_TIMEOUT_MS=0
# Seconds to wait for the database on startup
# DB_WAIT_SECONDS=60

# Required. Encrypts the TOTP seeds in the database and signs the SSO state cookie. The app
# refuses to start without one (or with a value shorter than 32 characters). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it later: run `magma rotate-secret --old <previous key>` with the new key set,
# otherwise every enrolled authenticator app stops working.
SECRET_KEY=
# Local development only: start with a weak key anyway (logs a warning).
# ALLOW_WEAK_SECRET_KEY=false

# First admin account, created on first start when no users exist.
# Without ADMIN_PASSWORD a random password is generated and printed once in the container log.
# Changing ADMIN_PASSWORD later does nothing; reset a password with
#   docker compose exec magma magma reset-password [--from-env]
ADMIN_USER=admin
# ADMIN_PASSWORD=

# Local login and session settings
# LOCAL_LOGIN_ENABLED=true
# SESSION_HOURS=12
# SSO sessions are shorter, because the app only learns at the next sign-in that someone
# lost access at the identity provider.
# SSO_SESSION_HOURS=8
# Largest request body in MB (larger requests get 413).
# MAX_BODY_MB=25
# Total size of all interview evidence files in MB (0 = no limit). Evidence lives in the
# database: back it up with the database (or magma db-copy); the JSON export has no file content.
# EVIDENCE_MAX_TOTAL_MB=2048

# SSO via OpenID Connect (Entra ID, Keycloak, Okta, ADFS, Authentik ...).
# Usually set up in the app: Administration -> Single sign-on. Set these variables only to manage
# SSO in the environment instead; when OIDC_ISSUER is set they apply and the page is read-only.
# Register the redirect URI <BASE_URL>/api/auth/oidc/callback at your IdP.
# SSO is on when OIDC_ISSUER and OIDC_CLIENT_ID are set.
# OIDC_ISSUER=https://login.example.com/realms/soc
# OIDC_CLIENT_ID=magma
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email
# Claim with the groups/roles; dotted paths work, e.g. realm_access.roles
# OIDC_ROLE_CLAIM=groups
# OIDC_ROLE_MAP=SOC-Admins=admin,SOC-Analysts=analyst,Audit=auditor
# Role for users without a matching group (empty = no access)
# OIDC_DEFAULT_ROLE=
# OIDC_USERNAME_CLAIM=preferred_username
# Empty: "Sign in with SSO" ("Sign in with Microsoft" for Entra ID) in the user's language
# OIDC_BUTTON_LABEL=
#
# Local test with the bundled Keycloak (docker compose --profile keycloak up -d):
# OIDC_ISSUER=http://keycloak:8080/realms/magma
# OIDC_CLIENT_ID=magma
# OIDC_CLIENT_SECRET=magma-dev-secret
# OIDC_ROLE_MAP=SOC-Admins=admin,SOC-Analysts=analyst,Audit=auditor
#
# Microsoft Entra ID (Azure AD) with app roles; steps in the README. Use the tenant ID,
# not common / organizations. With the groups claim instead, map group object IDs:
#   OIDC_ROLE_CLAIM=groups  OIDC_ROLE_MAP=<object id>=admin,<object id>=analyst
# OIDC_ISSUER=https://login.microsoftonline.com/<Directory (tenant) ID>/v2.0
# OIDC_CLIENT_ID=<Application (client) ID>
# OIDC_CLIENT_SECRET=<client secret value>
# OIDC_SCOPES=openid profile email User.Read
# OIDC_ROLE_CLAIM=roles
# OIDC_ROLE_MAP=Vulcan.Admin=admin,Vulcan.Analyst=analyst,Vulcan.Auditor=auditor

# Load generated demo data on first start (random but reproducible per seed).
# Can also be loaded later with: python -m app.demo --seed 42
# DEMO_DATA=false
# "Load demo data" on the Import / Export page (admin) deletes the verification, lifecycle and
# configuration history. It is only offered when this or DEMO_DATA is on. Leave off in production.
# ALLOW_DEMO_DATA=false
# DEMO_SEED=42

# Target implementation per risk level (1-5) when a use case has no own target
# RISK_TARGETS=1=0.4,2=0.5,3=0.6,4=0.75,5=0.9

# Drivers whose linked use cases score below this average weight are flagged as low coverage
# DRIVER_LOW_COVERAGE=0.3

# Default re-verification interval for operational rules (days); rules can override it
# DEFAULT_VERIFICATION_DAYS=180

# ---- History (M4) ----
# Automatic snapshots for the trend charts: off | daily | weekly | monthly
# SNAPSHOT_SCHEDULE=monthly

# ---- Optional git repository for the JSON configs of rules (M4) ----
# Off while GIT_REMOTE_URL is empty. The app pushes every config commit as a git commit
# (usecases/<L1>/<L2>/<L3>.json) and every tag as <code>/<tag>. HTTPS with a token or SSH with a key.
# GIT_REMOTE_URL=https://git.example.com/soc/magma-usecases.git
# GIT_BRANCH=main
# GIT_USERNAME=magma
# GIT_TOKEN=
# GIT_SSH_KEY_FILE=/run/secrets/magma_git_key   (with GIT_REMOTE_URL=git@host:soc/usecases.git)
# GIT_AUTO_SYNC=true
# GIT_AUTHOR_EMAIL_DOMAIN=magma.local
# Two-way sync (M7): read config changes pushed to the repository back into the app
# GIT_PULL=false
# GIT_PULL_INTERVAL_MINUTES=5
# Push webhook <BASE_URL>/api/git/webhook (GitHub/Gitea HMAC, GitLab token or X-Magma-Token)
# GIT_WEBHOOK_SECRET=
#
# Local test with `docker compose --profile gitea up -d`:
# GIT_REMOTE_URL=http://gitea:3000/magma/usecases.git
# GIT_USERNAME=magma
# GIT_TOKEN=magma-password
